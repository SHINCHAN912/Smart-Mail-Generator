# Database config (SQLite is default, change for production)
DATABASE_URL=sqlite:///./emails.db

# JWT config
JWT_SECRET=super-secret-key-smartmail-ai-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services keys
GROQ_API_KEY=your_groq_api_key_here

# AI Models (Defaults)
GROQ_MODEL=llama-3.3-70b-versatile
