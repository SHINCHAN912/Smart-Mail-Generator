# Database config (SQLite is default, change for production)
DATABASE_URL=sqlite:///./emails.db

# JWT config
JWT_SECRET=super-secret-key-smartmail-ai-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services keys (Set at least GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# AI Models (Defaults)
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
